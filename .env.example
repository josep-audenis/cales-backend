APP_NAME=cales-backend
ENV=dev
DEBUG=false

# Frontend/browser access. Use comma-separated origins or * for demo mode.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public backend URL used in generated PDF links.
PUBLIC_BASE_URL=http://localhost:8000

# Report/PDF persistence.
REPORT_STORAGE_DIR=.cales_reports

# LLM provider. HF_MODEL_* aliases are supported for the Hugging Face endpoint.
LLM_PROVIDER=hf
HF_MODEL_BASE_URL=https://your-hf-space-or-router.example/v1
HF_MODEL_API_KEY=your-key
HF_MODEL_NAME=your-model-name
HF_MODEL_API_TYPE=openai_compatible_chat

# Optional Groq fallback.
GROQ_API_KEY=
